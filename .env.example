# =====================================================================================
# Configuración del microservicio OKF
# =====================================================================================
#
# Copia este archivo como `.env` en la raíz del repositorio y ajusta los valores:
#
#     cp .env.example .env
#
# Quién lo lee:
#   - El binario en el host (`cargo run -- api`, `cargo run -- worker`) lo carga al
#     arrancar. Una variable ya definida en el entorno del proceso tiene prioridad sobre
#     la de este archivo.
#   - Docker Compose lo pasa completo a la API y al worker (`env_file: .env` en
#     `compose.yaml`). Compose fija aparte `OKF_DATABASE_URL`, `OKF_DATA_DIR` y, en el
#     worker, `OKF_OCR_MODELS_DIR`, porque dentro del contenedor las rutas y el host de
#     PostgreSQL son otros.
#
# Cuándo se aplica un cambio: al reiniciar el proceso. Con Compose, recrea el servicio
# afectado (los ajustes de conversión son del worker):
#
#     docker compose up -d --no-deps --force-recreate worker
#
# Formato: `NOMBRE=valor`, sin espacios alrededor del `=` y sin comillas. Una línea que
# empieza por `#` es un comentario; para volver al valor por defecto del código, comenta
# o borra la línea. Los números son enteros. Un valor inválido impide arrancar, con un
# mensaje que nombra la variable. La referencia completa está en la arquitectura
# técnica, §5 (docs/arquitectura/ARQUITECTURA_TECNICA_MICROSERVICIO_OKF.md).
#
# Configuración genérica para desarrollo local: cambia las contraseñas antes de un
# despliegue real.


# -------------------------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------------------------
# Base, usuario y contraseña con que Compose crea el contenedor de PostgreSQL la primera
# vez (con un volumen nuevo). Cambiarlos después no modifica una base que ya existe.
POSTGRES_DB=okf
POSTGRES_USER=okf
POSTGRES_PASSWORD=okf_test_password
# Puerto del host en que Compose publica PostgreSQL, solo en 127.0.0.1.
POSTGRES_PORT=5432

# Conexión del binario ejecutado en el host (cargo run). Obligatoria.
OKF_DATABASE_URL=postgresql://okf:okf_test_password@127.0.0.1:5432/okf?sslmode=disable
# Conexión de la API y el worker ejecutados por Compose: el host de PostgreSQL es el
# servicio `postgres` de la red interna. Compose la pasa como OKF_DATABASE_URL.
OKF_DATABASE_URL_DOCKER=postgresql://okf:okf_test_password@postgres:5432/okf?sslmode=disable
# Base separada y desechable para `cargo test`; se crea al iniciar un volumen nuevo
# (tools/postgres-init.sql). Las pruebas nunca usan la base del servicio.
OKF_TEST_DATABASE_URL=postgresql://okf:okf_test_password@127.0.0.1:5432/okf_test?sslmode=disable


# -------------------------------------------------------------------------------------
# API y almacenamiento
# -------------------------------------------------------------------------------------
# Carpeta de originales, intentos y bundles publicados del binario en el host. En
# Compose es el volumen `/data`.
OKF_DATA_DIR=data
# true publica Swagger UI (/docs/) y el contrato OpenAPI (/api-docs/openapi.json);
# false los oculta y la API sigue funcionando.
OKF_SWAGGER_ENABLED=true
# Tamaño máximo de un archivo subido, en MiB; por encima, la API responde 413.
# OKF_MAX_UPLOAD_MB=100
# Trabajos sin terminar (en cola o en proceso) a partir de los cuales la API responde
# 429; 0 no limita.
# OKF_MAX_QUEUED=0
# Espacio libre mínimo del volumen de datos, en MiB, por debajo del cual la API
# responde 507; 0 no lo comprueba.
# OKF_MIN_FREE_MB=0
# Días desde la finalización tras los que expiran los trabajos terminados y sus
# archivos; 0 los conserva siempre.
# OKF_RETENTION_DAYS=0


# -------------------------------------------------------------------------------------
# Recursos de cada conversión
# -------------------------------------------------------------------------------------
# Cada conversión se ejecuta en un proceso hijo aislado con estos límites. Los valores
# activos están pensados para escaneos largos: con ellos, un PDF escaneado de 200
# páginas se transcribe completo con OCR en unos 6 minutos y unos 2 GB de memoria
# (docs/decisiones/OCR_LOCAL.md, §5). Con los valores por defecto del código (1 hilo,
# 300 s y 500 MB), ese mismo escaneo sale `partial`, con unas 40 páginas transcritas.

# Hilos de una conversión PDF. Reparten la lectura del texto, la codificación de las
# imágenes, el renderizado de las vistas y el OCR de las páginas escaneadas (en grupos
# de tantas páginas como hilos). El bundle es idéntico con cualquier número de hilos.
# Cada hilo abre su propia copia del documento (unas 2 veces el tamaño del PDF) y, con
# OCR, analiza su propia página, así que la memoria crece con los hilos: súbelos junto
# con OKF_MAX_MEMORY_MB. Conviene no pasar del número de núcleos disponibles, porque el
# reconocimiento del OCR usa además 2 hilos internos por página. Los demás formatos
# convierten en un hilo. Entre 1 y 64; por defecto, 1.
OKF_CONVERSION_THREADS=4

# Duración máxima de una conversión, en segundos. Al superarla, el worker detiene el
# proceso y el trabajo falla sin reintentos. También fija el presupuesto del OCR: no
# empieza otra página ni otra imagen tras consumir dos tercios de este plazo (600 s con
# 900), y las restantes quedan como vista, con el bundle en `partial` en vez de fallar.
# Un escaneo de 200 páginas con 4 hilos necesita al menos unos 700 s. Por defecto, 300.
OKF_CONVERSION_TIMEOUT_S=900

# Tiempo de CPU máximo de una conversión, sumados sus hilos (RLIMIT_CPU), en segundos.
# El OCR también deja de empezar páginas al consumir dos tercios de este valor. Sin
# declarar, vale OKF_CONVERSION_TIMEOUT_S × OKF_CONVERSION_THREADS (3600 s con los
# valores de arriba), que es lo recomendable; declararlo más bajo deja páginas sin OCR
# antes de agotar el plazo. Mayor que 0.
# OKF_MAX_CPU_S=3600

# Memoria residente máxima de una conversión, en MB. El worker la vigila y, en Linux
# (Docker), la aplica además como RLIMIT_AS; una conversión que la supera falla sin
# reintentos. Rige para todos los formatos; un PDF con el OCR activo suma
# OKF_OCR_MEMORY_MB (1500 + 512 = 2012 MB con estos valores). Con 4 hilos y OCR, un
# escaneo se estabiliza en unos 1800 MB. La máquina virtual de Docker Desktop debe
# tener memoria para esto más PostgreSQL y la API (al menos unos 3 GB). Por defecto,
# 500.
OKF_MAX_MEMORY_MB=1500

# Tamaño máximo de cada archivo que escribe el conversor, en MB (RLIMIT_FSIZE).
# OKF_MAX_OUTPUT_MB=512
# Intentos máximos de un trabajo ante fallos transitorios.
# OKF_MAX_ATTEMPTS=3
# Segundos que el worker espera a la conversión en curso tras SIGTERM/SIGINT antes de
# detenerla y devolver el trabajo a la cola; 0 la interrumpe sin espera.
# OKF_SHUTDOWN_GRACE_S=30


# -------------------------------------------------------------------------------------
# OCR local de PDF
# -------------------------------------------------------------------------------------
# true transcribe con OCR local (sin servicios externos) las páginas PDF escaneadas sin
# capa de texto y el texto de las imágenes de contenido (capturas, diagramas, tablas
# pegadas como imagen). El servicio decide qué páginas e imágenes lo necesitan; la API
# no cambia. El texto reconocido se marca como tal, con su confianza, y la vista o la
# imagen se adjunta siempre como referencia. Con true, el worker no arranca si faltan
# los modelos. Solo true o false; por defecto, true.
OKF_OCR_ENABLED=true

# Carpeta con los modelos (det.onnx, rec.onnx y dict.txt) para el binario en el host;
# tools/ocr_models.sh los descarga y verifica aquí. En Docker, la imagen los incluye y
# Compose fija su ruta, así que este valor no se usa.
OKF_OCR_MODELS_DIR=models/ocr

# Páginas escaneadas que se transcriben como máximo en un documento; las demás quedan
# como vista, con una incidencia, y el bundle sale `partial`. Cada página densa cuesta
# unos 5–9 s de CPU, así que este límite debe ir de acuerdo con el plazo: 200 páginas
# caben en 900 s con 4 hilos. Mayor que 0 con el OCR activo; por defecto, 40.
OKF_OCR_MAX_PAGES=200

# Imágenes de contenido cuyo texto se transcribe como máximo en un documento; las demás
# se adjuntan sin transcribir y el informe lo declara. Rige el mismo presupuesto de dos
# tercios del plazo y de la CPU. Por defecto, 300.
OKF_OCR_MAX_IMAGES=300

# MB que se suman a OKF_MAX_MEMORY_MB al convertir un PDF con el OCR activo (los
# modelos y la detección del texto). Por defecto, 512.
OKF_OCR_MEMORY_MB=512


# -------------------------------------------------------------------------------------
# Límites por formato
# -------------------------------------------------------------------------------------
# Protegen al servicio de documentos desmesurados o maliciosos; el informe de
# conversión declara lo que no se convierte. Los valores comentados son los del código.
# Páginas máximas de un PDF.
# OKF_MAX_PAGES=2000
# Píxeles máximos de una imagen que el conversor decodifica; una mayor no se adjunta y
# se declara como pérdida.
# OKF_MAX_IMAGE_PIXELS=33554432
# Diapositivas máximas de una presentación PPTX.
# OKF_MAX_SLIDES=300
# Bloques máximos (párrafos y tablas de primer nivel) de un DOCX.
# OKF_MAX_BLOCKS=50000
# Celdas con contenido máximas de un libro XLSX.
# OKF_MAX_CELLS=1000000
# Límites de los paquetes OOXML (PPTX, DOCX, XLSX) contra bombas de compresión: tamaño
# descomprimido de una parte y del paquete, en MiB, y número de partes.
# OKF_MAX_ZIP_ENTRY_MB=128
# OKF_MAX_ZIP_TOTAL_MB=512
# OKF_MAX_ZIP_ENTRIES=4096
# Tamaño máximo, en bytes, del campo `access` (permisos) de una subida; uno mayor, mal
# formado o repetido recibe 400.
# OKF_MAX_ACCESS_BYTES=16384
# Archivo TrueType para las vistas PPTX; sin declarar, se busca una fuente instalada.
# OKF_FONT_PATH=/ruta/a/fuente.ttf


# -------------------------------------------------------------------------------------
# Registro
# -------------------------------------------------------------------------------------
# Nivel de los registros: error, warn, info, debug o trace (también por módulo, por
# ejemplo `info,okf_microservice=debug`).
RUST_LOG=info
