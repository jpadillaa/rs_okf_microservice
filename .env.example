# Configuración genérica para desarrollo local. Cambiar antes de un despliegue real.
POSTGRES_DB=okf
POSTGRES_USER=okf
POSTGRES_PASSWORD=okf_test_password
POSTGRES_PORT=5432

# Binario ejecutado en el host (cargo run).
OKF_DATABASE_URL=postgresql://okf:okf_test_password@127.0.0.1:5432/okf?sslmode=disable
# API/worker ejecutados por Compose: el host de PostgreSQL es el servicio postgres.
OKF_DATABASE_URL_DOCKER=postgresql://okf:okf_test_password@postgres:5432/okf?sslmode=disable
# Base separada y desechable para cargo test. Se crea al iniciar un volumen nuevo.
OKF_TEST_DATABASE_URL=postgresql://okf:okf_test_password@127.0.0.1:5432/okf_test?sslmode=disable
OKF_DATA_DIR=data
# true habilita /docs/ y /api-docs/openapi.json; false los deshabilita.
OKF_SWAGGER_ENABLED=true
# OCR local de las páginas PDF escaneadas sin capa de texto: true lo activa.
# El servicio decide solo qué páginas lo necesitan; la API no cambia.
OKF_OCR_ENABLED=false
# Modelos para el binario en el host (tools/ocr_models.sh los descarga aquí).
# En Docker, la imagen los incluye y Compose fija su ruta.
OKF_OCR_MODELS_DIR=models/ocr
# Páginas con OCR por documento; las demás quedan como vista e incidencia. El OCR
# tampoco empieza una página tras consumir 2/3 de OKF_CONVERSION_TIMEOUT_S.
OKF_OCR_MAX_PAGES=40
# MB que se suman a OKF_MAX_MEMORY_MB al convertir un PDF con el OCR activo.
OKF_OCR_MEMORY_MB=256
RUST_LOG=info
