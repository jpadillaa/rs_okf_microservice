{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:okf-microservice:perfil:1.18.0:frontmatter",
  "title": "Frontmatter del perfil documental OKF 1.18.0",
  "description": "Frontmatter, leído como JSON, de documento.md, conversion-report.md y cada concepto de contenido/ en un bundle del perfil 1.18.0. Los índices no tienen frontmatter salvo el raíz (okf_version), que OKF regula. Los localizadores de bloque PDF están en el archivo que nombra block_spans y se describen en $defs/blockSpansFile. Cada tipo admite solo sus campos: un campo nuevo o que cambia de significado exige otra versión del perfil y de este esquema (especificación, §2).",
  "oneOf": [
    {
      "$ref": "#/$defs/sourceDocument"
    },
    {
      "$ref": "#/$defs/conversionReport"
    },
    {
      "$ref": "#/$defs/sourceSection"
    },
    {
      "$ref": "#/$defs/sourceText"
    },
    {
      "$ref": "#/$defs/slide"
    },
    {
      "$ref": "#/$defs/sheet"
    },
    {
      "$ref": "#/$defs/sheetRegion"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "conceptPath": {
      "type": "string",
      "pattern": "^contenido/[^/]+\\.md$"
    },
    "generated": {
      "type": "object",
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "const": "process:document-conversion"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "resource"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "resource": {
            "type": "string",
            "pattern": "^/references/original\\.(pdf|docx|xlsx|pptx)$"
          }
        }
      }
    },
    "box": {
      "type": "object",
      "required": [
        "page",
        "x0",
        "top",
        "x1",
        "bottom"
      ],
      "additionalProperties": false,
      "properties": {
        "page": {
          "$ref": "#/$defs/positive"
        },
        "x0": {
          "type": "number",
          "minimum": 0
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "x1": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "span": {
      "type": "object",
      "required": [
        "id",
        "source_id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "source_id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "pdf_pages",
            "docx_blocks",
            "xlsx_range",
            "pptx_slide",
            "pptx_shape"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": true,
            "source_id": true,
            "kind": {
              "const": "pdf_pages"
            },
            "from": {
              "$ref": "#/$defs/positive"
            },
            "to": {
              "$ref": "#/$defs/positive"
            },
            "boxes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/box"
              }
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "id": true,
            "source_id": true,
            "kind": {
              "const": "docx_blocks"
            },
            "from": {
              "$ref": "#/$defs/positive"
            },
            "to": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "id": true,
            "source_id": true,
            "kind": {
              "const": "xlsx_range"
            },
            "sheet": {
              "$ref": "#/$defs/text"
            },
            "range": {
              "type": "string",
              "pattern": "^\\$?[A-Z]{1,3}\\$?[0-9]+(:\\$?[A-Z]{1,3}\\$?[0-9]+)?$"
            }
          },
          "required": [
            "sheet",
            "range"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "id": true,
            "source_id": true,
            "kind": {
              "const": "pptx_slide"
            },
            "slide_index": {
              "$ref": "#/$defs/positive"
            },
            "slide_id": {
              "type": "integer",
              "minimum": 0
            },
            "display_label": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "slide_index"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^f-[0-9]+$"
            },
            "source_id": true,
            "kind": {
              "const": "pptx_shape"
            },
            "slide_index": {
              "$ref": "#/$defs/positive"
            },
            "shape_id": {
              "type": "integer",
              "minimum": 0
            },
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "cx": {
              "type": "integer",
              "minimum": 0
            },
            "cy": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "slide_index",
            "shape_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "conversionSettings": {
      "description": "Configuración que cambia el contenido del bundle de cada formato (especificación, §2).",
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "required": [
            "view_font_sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "view_font_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "max_image_pixels",
            "ocr"
          ],
          "additionalProperties": false,
          "properties": {
            "max_image_pixels": {
              "type": "integer",
              "minimum": 0
            },
            "ocr": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "enabled"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "enabled",
                    "max_pages",
                    "max_images",
                    "timeout_s",
                    "det_sha256",
                    "rec_sha256",
                    "dict_sha256"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "const": true
                    },
                    "max_pages": {
                      "$ref": "#/$defs/positive"
                    },
                    "max_images": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "timeout_s": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "det_sha256": {
                      "$ref": "#/$defs/modelHash"
                    },
                    "rec_sha256": {
                      "$ref": "#/$defs/modelHash"
                    },
                    "dict_sha256": {
                      "$ref": "#/$defs/modelHash"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "modelHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": "ausente"
        }
      ]
    },
    "sourceDocument": {
      "type": "object",
      "required": [
        "type",
        "unit_id",
        "title",
        "description",
        "sources",
        "generated",
        "converter_version",
        "converter_commit",
        "profile_version",
        "conversion_settings",
        "settings_sha256",
        "conversion_id",
        "source_file"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Source Document"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}/documento\\.md$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generated": {
          "$ref": "#/$defs/generated"
        },
        "converter_version": {
          "$ref": "#/$defs/id_converter_version"
        },
        "converter_commit": {
          "$ref": "#/$defs/id_converter_commit"
        },
        "profile_version": {
          "$ref": "#/$defs/id_profile_version"
        },
        "conversion_settings": {
          "$ref": "#/$defs/id_conversion_settings"
        },
        "settings_sha256": {
          "$ref": "#/$defs/id_settings_sha256"
        },
        "reproducible": {
          "$ref": "#/$defs/id_reproducible"
        },
        "conversion_id": {
          "$ref": "#/$defs/id_conversion_id"
        },
        "document_key": {
          "$ref": "#/$defs/id_document_key"
        },
        "access": {
          "$ref": "#/$defs/id_access"
        },
        "source_file": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^references/original\\.(pdf|docx|xlsx|pptx)$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "source_spans": {
          "$ref": "#/$defs/spans"
        },
        "page_labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "conversionReport": {
      "type": "object",
      "required": [
        "type",
        "unit_id",
        "title",
        "generated",
        "status",
        "format",
        "sha256",
        "converter_version",
        "converter_commit",
        "profile_version",
        "conversion_settings",
        "settings_sha256",
        "conversion_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Conversion Report"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}/conversion-report\\.md$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "generated": {
          "$ref": "#/$defs/generated"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "xlsx",
            "pptx"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "converter_version": {
          "$ref": "#/$defs/id_converter_version"
        },
        "converter_commit": {
          "$ref": "#/$defs/id_converter_commit"
        },
        "profile_version": {
          "$ref": "#/$defs/id_profile_version"
        },
        "conversion_settings": {
          "$ref": "#/$defs/id_conversion_settings"
        },
        "settings_sha256": {
          "$ref": "#/$defs/id_settings_sha256"
        },
        "reproducible": {
          "$ref": "#/$defs/id_reproducible"
        },
        "conversion_id": {
          "$ref": "#/$defs/id_conversion_id"
        },
        "document_key": {
          "$ref": "#/$defs/id_document_key"
        },
        "access": {
          "$ref": "#/$defs/id_access"
        }
      }
    },
    "sourceSection": {
      "type": "object",
      "required": [
        "type",
        "unit_id",
        "parent",
        "title",
        "description",
        "sources",
        "generated",
        "source_spans"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Source Section"
        },
        "unit_id": {
          "$ref": "#/$defs/concept_unit_id"
        },
        "parent": {
          "$ref": "#/$defs/concept_parent"
        },
        "previous": {
          "$ref": "#/$defs/conceptPath"
        },
        "next": {
          "$ref": "#/$defs/conceptPath"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generated": {
          "$ref": "#/$defs/generated"
        },
        "source_spans": {
          "$ref": "#/$defs/spans"
        },
        "block_spans": {
          "type": "string",
          "pattern": "^/contenido/[^/]+\\.spans\\.json$",
          "description": "Ruta, desde la raíz del bundle, del archivo con los localizadores de los bloques del concepto (<concepto>.spans.json); sus identificadores resuelven los marcadores okf-source-span del cuerpo (especificación, §3)."
        },
        "status": {
          "$ref": "#/$defs/concept_status"
        },
        "title_inferred": {
          "const": true
        }
      }
    },
    "sourceText": {
      "type": "object",
      "required": [
        "type",
        "unit_id",
        "parent",
        "title",
        "description",
        "sources",
        "generated",
        "source_spans"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Source Text"
        },
        "unit_id": {
          "$ref": "#/$defs/concept_unit_id"
        },
        "parent": {
          "$ref": "#/$defs/concept_parent"
        },
        "previous": {
          "$ref": "#/$defs/conceptPath"
        },
        "next": {
          "$ref": "#/$defs/conceptPath"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generated": {
          "$ref": "#/$defs/generated"
        },
        "source_spans": {
          "$ref": "#/$defs/spans"
        },
        "block_spans": {
          "type": "string",
          "pattern": "^/contenido/[^/]+\\.spans\\.json$",
          "description": "Ruta, desde la raíz del bundle, del archivo con los localizadores de los bloques del concepto (<concepto>.spans.json); sus identificadores resuelven los marcadores okf-source-span del cuerpo (especificación, §3)."
        },
        "status": {
          "$ref": "#/$defs/concept_status"
        },
        "title_inferred": {
          "const": true
        }
      }
    },
    "slide": {
      "type": "object",
      "required": [
        "type",
        "unit_id",
        "parent",
        "title",
        "description",
        "sources",
        "generated",
        "source_spans"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Slide"
        },
        "unit_id": {
          "$ref": "#/$defs/concept_unit_id"
        },
        "parent": {
          "const": "documento.md"
        },
        "previous": {
          "$ref": "#/$defs/conceptPath"
        },
        "next": {
          "$ref": "#/$defs/conceptPath"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generated": {
          "$ref": "#/$defs/generated"
        },
        "source_spans": {
          "$ref": "#/$defs/spans"
        },
        "status": {
          "$ref": "#/$defs/concept_status"
        },
        "title_inferred": {
          "const": true
        },
        "kicker": {
          "$ref": "#/$defs/text"
        },
        "section": {
          "$ref": "#/$defs/text"
        },
        "visual_only": {
          "const": true
        },
        "view_hides_text": {
          "const": true
        }
      }
    },
    "sheet": {
      "type": "object",
      "required": [
        "type",
        "unit_id",
        "parent",
        "title",
        "description",
        "sources",
        "generated",
        "sheet_index"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Sheet"
        },
        "unit_id": {
          "$ref": "#/$defs/concept_unit_id"
        },
        "parent": {
          "const": "documento.md"
        },
        "previous": {
          "$ref": "#/$defs/conceptPath"
        },
        "next": {
          "$ref": "#/$defs/conceptPath"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generated": {
          "$ref": "#/$defs/generated"
        },
        "sheet_index": {
          "$ref": "#/$defs/positive"
        },
        "sheet_state": {
          "enum": [
            "hidden",
            "veryHidden"
          ]
        },
        "source_spans": {
          "$ref": "#/$defs/spans"
        },
        "status": {
          "$ref": "#/$defs/concept_status"
        }
      }
    },
    "sheetRegion": {
      "type": "object",
      "required": [
        "type",
        "unit_id",
        "parent",
        "title",
        "description",
        "sources",
        "generated",
        "sheet_index",
        "source_spans"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Sheet Region"
        },
        "unit_id": {
          "$ref": "#/$defs/concept_unit_id"
        },
        "parent": {
          "$ref": "#/$defs/conceptPath"
        },
        "previous": {
          "$ref": "#/$defs/conceptPath"
        },
        "next": {
          "$ref": "#/$defs/conceptPath"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generated": {
          "$ref": "#/$defs/generated"
        },
        "sheet_index": {
          "$ref": "#/$defs/positive"
        },
        "sheet_state": {
          "enum": [
            "hidden",
            "veryHidden"
          ]
        },
        "source_spans": {
          "$ref": "#/$defs/spans"
        },
        "status": {
          "$ref": "#/$defs/concept_status"
        }
      }
    },
    "id_converter_version": {
      "$ref": "#/$defs/text"
    },
    "id_converter_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|unknown)$"
    },
    "id_profile_version": {
      "const": "1.18.0"
    },
    "id_conversion_settings": {
      "$ref": "#/$defs/conversionSettings"
    },
    "id_settings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "id_reproducible": {
      "const": false
    },
    "id_conversion_id": {
      "$ref": "#/$defs/sha256"
    },
    "id_document_key": {
      "type": "string",
      "pattern": "^[!-~]{1,256}$"
    },
    "id_access": {
      "type": "string",
      "minLength": 1
    },
    "concept_unit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}/contenido/[^/]+\\.md$"
    },
    "concept_parent": {
      "anyOf": [
        {
          "const": "documento.md"
        },
        {
          "$ref": "#/$defs/conceptPath"
        }
      ]
    },
    "concept_status": {
      "const": "draft"
    },
    "blockSpansFile": {
      "description": "Archivo <concepto>.spans.json de un concepto PDF: el concepto al que pertenece y los localizadores de sus bloques, con la misma forma que source_spans.",
      "type": "object",
      "required": [
        "concept",
        "source_spans"
      ],
      "additionalProperties": false,
      "properties": {
        "concept": {
          "$ref": "#/$defs/conceptPath"
        },
        "source_spans": {
          "$ref": "#/$defs/spans"
        }
      }
    }
  }
}
